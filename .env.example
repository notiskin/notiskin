# Supabase credentials for the marketplace backend.
# Copy this file to .env and fill in the values from your Supabase project:
# Project Settings → API → Project URL and API Keys.
#
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are used at runtime (catalog fetch, submissions).
# SUPABASE_SECRET_KEY is only needed if you run server-side admin scripts directly.
# The publishable key is also hardcoded in marketplace/browse.html and marketplace/submit.html
# for the browser-side Supabase client, update those too if you change projects.

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub personal access token (repo scope) — only needed when running `npm run publish`.
# Generate one at https://github.com/settings/tokens
GH_TOKEN=your_github_personal_access_token_here
