# Local development and release only. This file is never packaged into the app
# (scripts/check-bundle.js fails the build if it is).

# Optional: point the app at a different Supabase project. Defaults to the public Notiskin project.
# The publishable key is safe to ship. Never put the service role / secret key here.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Release only: a fine-grained token scoped to notiskin/notiskin with "Contents: read and write".
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
