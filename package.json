{
  "name": "notiskin",
  "version": "0.7.0",
  "private": true,
  "description": "Open source modding tool for the Notion desktop app. Apply CSS themes and JavaScript plugins to Notion's Electron client",
  "main": "dist/electron/main.js",
  "bin": {
    "notiskin": "dist/cli/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "dev": "tsc --watch",
    "start": "npm run build && electron .",
    "apply": "npm run build && node dist/cli/index.js",
    "themes": "npm run build && node dist/cli/index.js themes",
    "theme": "npm run build && node dist/cli/index.js theme",
    "plugins": "npm run build && node dist/cli/index.js plugins",
    "plugin": "npm run build && node dist/cli/index.js plugin",
    "patch": "npm run build && node dist/cli/index.js patch",
    "unpatch": "npm run build && node dist/cli/index.js unpatch",
    "watch": "npm run build && node dist/patcher/watcher.js",
    "watch:install": "npm run build && node dist/cli/index.js watch:install",
    "watch:uninstall": "npm run build && node dist/cli/index.js watch:uninstall",
    "gui": "npm run build && node dist/gui/run.js",
    "test": "npm run build && node --test 'test/*.test.js'",
    "test:integration": "npm run build && node --test --test-concurrency=1 'test/integration/*.test.js'",
    "clean": "rm -rf dist",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "publish": "node publish.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "publish:dry-run": "node publish.js --dry-run"
  },
  "keywords": [
    "notion",
    "modding",
    "themes",
    "plugins",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "build": {
    "appId": "com.notiskin.app",
    "productName": "notiskin",
    "publish": {
      "provider": "github",
      "owner": "notiskin",
      "repo": "notiskin",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/**/*.d.ts",
      "src/gui/**/*.html",
      "src/gui/**/*.js",
      "src/gui/**/*.css",
      "src/gui/fonts/*.woff2",
      "src/gui/fonts/*.txt",
      "package.json"
    ],
    "afterPack": "scripts/check-bundle.js"
  }
}
